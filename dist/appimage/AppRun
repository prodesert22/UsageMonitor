#!/bin/sh
# AppRun for the usage-monitor-cli AppImage. Forward every invocation to the
# bundled binary. The AppImage mount is temporary, so desktop widget installs
# should use a native package or the generic tarball.
# `readlink -f` keeps this working both under the AppImage runtime (where
# $APPDIR is set) and when the AppImage is extracted with --appimage-extract.
HERE="$(dirname "$(readlink -f "$0")")"
exec "$HERE/usr/bin/usage-monitor-cli" "$@"
